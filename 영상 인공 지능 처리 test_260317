        "import numpy as np\n",
        "import cv2\n",
        "from google.colab.patches import cv2_imshow\n",
        "\n",
        "#256×256 크기의 2차원 배열을 생성하였습니다.\n",
        "H = W = 256\n",
        "\n",
        "#배열 a: 위쪽 200행을 0으로 설정 = a는 아래쪽만 흰색(1)인 형태\n",
        "a = np.ones((H, W), dtype=np.uint8)\n",
        "a[:200, :] = 0\n",
        "\n",
        "#배열 b: 오른쪽 200열을 0으로 설정 = b는 왼쪽만 흰색(1)인 형태\n",
        "b = np.ones((H, W), dtype=np.uint8)\n",
        "b[:, -200:] = 0\n",
        "\n",
        "# 두 이미지가 모두 1인 부분(겹치는 영역)만 남는 AND 연산\n",
        "and_ab = cv2.subtract(a, cv2.subtract(a,b))\n",
        "\n",
        "#하나라도 1인 부분을 모두 포함하는 OR 연산\n",
        "or_ab = cv2.add(a, b)\n",
        "\n",
        "#배열의 값은 0과 1로 이루어져 있기 때문에\n",
        "#이를 이미지로 확인하기 위해 255를 곱하여 0(검정), 255(흰색)으로 변환하였습니다.\n",
        "print(\"\\n[a]\");     cv2_imshow(a * 255)\n",
        "print(\"\\n[b]\");     cv2_imshow(b * 255)\n",
        "print(\"\\n[AND]\");   cv2_imshow(and_ab * 255)\n",
        "print(\"\\n[OR]\");    cv2_imshow(or_ab * 255)"
      ],
